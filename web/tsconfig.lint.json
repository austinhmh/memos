{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/outline-vendor/*": ["./types/outline-lint-stubs.d.ts"],
      "@/outline-shims/*": ["./types/outline-lint-stubs.d.ts"],
      "@shared/editor/*": ["./types/outline-lint-stubs.d.ts"],
      "@shared/*": ["./types/outline-lint-stubs.d.ts"],
      "~/editor/*": ["./types/outline-lint-stubs.d.ts"],
      "~/editor": ["./types/outline-lint-stubs.d.ts"],
      "~/*": ["./types/outline-lint-stubs.d.ts"]
    }
  },
  "include": ["./src", "./types/outline-lint-stubs.d.ts"],
  "exclude": [
    "./src/outline-vendor/**/*",
    "./src/outline-shims/**/*",
    "./src/components/OutlineEditorWrapper.tsx"
  ]
}
