# Copy this file to .env for local Docker helper scripts.
# Never commit real tokens or passwords.

# Required only when pushing/pulling private GHCR images.
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_replace_with_a_package_scoped_token

# Optional image override.
# IMAGE_NAME=ghcr.io/your-github-username/memos

# Optional local deployment settings used by pull.sh.
# MEMOS_HOST_ADDR=127.0.0.1
# MEMOS_HOST_PORT=8081
# MEMOS_INSTANCE_URL=http://localhost:8081
# MEMOS_DATA_DIR=/absolute/path/to/memos-data

# Optional Docker build proxy. Do not include credentials in proxy URLs.
# MEMOS_PROXY_PORT=7897
# MEMOS_BUILD_PROXY=http://host.docker.internal:7897
